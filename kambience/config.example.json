{
  "_comment": "Copy to config.json and keep ONE block. API keys come from the environment variable named in api_key_env, never from this file.",

  "api": "openai",
  "base_url": "http://localhost:11434/v1",
  "model": "llama3.1:8b",
  "api_key_env": "",

  "_presets": {
    "ollama (local, free)":    {"api": "openai", "base_url": "http://localhost:11434/v1", "model": "llama3.1:8b", "api_key_env": ""},
    "LM Studio (local, free)": {"api": "openai", "base_url": "http://localhost:1234/v1", "model": "<loaded model>", "api_key_env": ""},
    "llama.cpp server":        {"api": "openai", "base_url": "http://localhost:8080/v1", "model": "local", "api_key_env": ""},
    "Anthropic (Claude)":      {"api": "anthropic", "model": "claude-opus-5-5", "api_key_env": "ANTHROPIC_API_KEY"},
    "OpenAI":                  {"api": "openai", "base_url": "https://api.openai.com/v1", "model": "<model name>", "api_key_env": "OPENAI_API_KEY"},
    "OpenRouter (any model)":  {"api": "openai", "base_url": "https://openrouter.ai/api/v1", "model": "<vendor/model>", "api_key_env": "OPENROUTER_API_KEY"},
    "Groq":                    {"api": "openai", "base_url": "https://api.groq.com/openai/v1", "model": "<model name>", "api_key_env": "GROQ_API_KEY"},
    "Google Gemini":           {"api": "openai", "base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "model": "<model name>", "api_key_env": "GEMINI_API_KEY"}
  }
}
